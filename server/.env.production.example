# ============================================================
# The Business Work API — Production Environment Configuration
# Domain: api.thebusinesswork.com
# Target: Cloud On Fire Ubuntu VPS (1 GB RAM optimized)
# ============================================================

# 1. Server Runtime
NODE_ENV=production
PORT=3001
API_URL=https://api.thebusinesswork.com
FRONTEND_URL=https://dashboard.thebusinesswork.com

# 2. SQLite Database & Storage
DATABASE_URL=/var/www/tbw-api/data/thebusinesswork.db
BACKUP_DIR=/var/backups/thebusinesswork
SQLITE_CACHE_SIZE_MB=8

# 3. Initial Provisioning & Security (MANDATORY IN PRODUCTION)
INITIAL_ADMIN_EMAIL=admin@thebusinesswork.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS

# 4. Authentication & Session Security (Generate with: openssl rand -hex 32)
SESSION_SECRET=REPLACE_WITH_HEX_64_CHAR_SECRET_KEY
SESSION_MAX_AGE_HOURS=72

# 4. Meta WhatsApp Cloud API (Keep blank until live testing)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_DEFAULT_TEMPLATE_NAMESPACE=

# 5. n8n Automation Engine Integration
N8N_API_KEY=REPLACE_WITH_STRONG_RANDOM_N8N_PRESHARED_KEY
N8N_BASE_URL=https://n8n.thebusinesswork.com
N8N_WEBHOOK_URL=https://n8n.thebusinesswork.com/webhook/tbw-wa-router

# 6. Rate Limiting & Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
