# Server
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Database
DB_PATH=./data/tbw.db

# Session & Initial Admin
INITIAL_ADMIN_EMAIL=admin@thebusinesswork.com
# For dev/testing, admin123 is accepted. For production, min 12 characters is enforced:
INITIAL_ADMIN_PASSWORD=change_this_to_a_strong_password_in_prod
SESSION_SECRET=change-this-to-a-random-64-char-string-in-production
SESSION_MAX_AGE_HOURS=72

# WhatsApp (Meta Cloud API) — do NOT fill unless you have credentials
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_BUSINESS_ACCOUNT_ID=

# n8n Integration
N8N_API_KEY=change-this-to-a-shared-secret-between-n8n-and-api
N8N_BASE_URL=https://n8n.thebusinesswork.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
