# Frontend / Vite — public values only
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# After ALL existing endpoints have migrated to Vercel:
VITE_API_URL=/api

# Vercel Function environment only — NEVER prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:REPLACE_PASSWORD@YOUR_POOLER_HOST:6543/postgres
TBW_OWNER_SUPABASE_UID=REPLACE_UUID
TBW_OWNER_LEGACY_ID=1
